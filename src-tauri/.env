# 客户端构建只读取本目录的 .env（见 vite.config.ts 的 envDir），不读取根目录 .env
# 本仓库不构建客户端，此文件仅保留上游结构；自行构建时按需覆盖
# VITE_DEFAULT_API_URL：留空表示使用官方默认地址；填 .json 路径会作为预置配置内嵌进安装包
VITE_DEFAULT_API_URL=
# 客户端默认使用内置字体，并从安装包自带的字体文件加载
VITE_DEFAULT_UI_FONT=builtin
VITE_DEFAULT_MONO_FONT=builtin
VITE_BUILTIN_FONT_SOURCE=local
# 客户端分享链接使用的网页版地址；留空时分享链接改用 deep link
VITE_WEB_APP_URL=
