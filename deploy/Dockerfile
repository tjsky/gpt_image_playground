# ---- Build stage ----
FROM --platform=$BUILDPLATFORM node:24-alpine AS build

WORKDIR /app

ENV VITE_DEFAULT_API_URL=__VITE_DEFAULT_API_URL_PLACEHOLDER__
ENV VITE_DEFAULT_API_KEY=__VITE_DEFAULT_API_KEY_PLACEHOLDER__
ENV VITE_DEFAULT_IMAGE_MODEL=__VITE_DEFAULT_IMAGE_MODEL_PLACEHOLDER__
ENV VITE_IMAGE_MODEL_NOTES=__VITE_IMAGE_MODEL_NOTES_PLACEHOLDER__
ENV VITE_DEFAULT_TEXT_MODEL=__VITE_DEFAULT_TEXT_MODEL_PLACEHOLDER__
ENV VITE_DEFAULT_TEXT_MODEL_NAME=__VITE_DEFAULT_TEXT_MODEL_NAME_PLACEHOLDER__
ENV VITE_API_PROXY_AVAILABLE=__VITE_API_PROXY_AVAILABLE_PLACEHOLDER__
ENV VITE_API_PROXY_LOCKED=__VITE_API_PROXY_LOCKED_PLACEHOLDER__
ENV VITE_DOCKER_DEPLOYMENT=__VITE_DOCKER_DEPLOYMENT_PLACEHOLDER__
ENV VITE_DOCKER_LEGACY_API_URL_USED=__VITE_DOCKER_LEGACY_API_URL_USED_PLACEHOLDER__
ENV VITE_SHOW_PRESET_CONFIG_ONLY=__VITE_SHOW_PRESET_CONFIG_ONLY_PLACEHOLDER__
ENV VITE_SHOW_CONFIG_CHANGE_DIALOG=__VITE_SHOW_CONFIG_CHANGE_DIALOG_PLACEHOLDER__
ENV VITE_LOCK_PRESET_CONFIG_PARAMS=__VITE_LOCK_PRESET_CONFIG_PARAMS_PLACEHOLDER__
ENV VITE_PREVENT_PRESET_CONFIG_DELETION=__VITE_PREVENT_PRESET_CONFIG_DELETION_PLACEHOLDER__
ENV VITE_DEFAULT_UI_FONT=__VITE_DEFAULT_UI_FONT_PLACEHOLDER__
ENV VITE_DEFAULT_MONO_FONT=__VITE_DEFAULT_MONO_FONT_PLACEHOLDER__
ENV VITE_BUILTIN_FONT_SOURCE=__VITE_BUILTIN_FONT_SOURCE_PLACEHOLDER__

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- Production stage ----
FROM nginx:alpine

ENV HOST=0.0.0.0
ENV PORT=80
# 前端可见的「假」地址与「假」KEY（可随意填写，仅用于前端展示与 Nginx 侧校验）
ENV DEFAULT_API_URL=
ENV DEFAULT_API_KEY=
# 后端真实上游与真实 KEY（只存在于容器内，不会进入前端产物）
# 图像上游；TEXT_API_URL / TEXT_API_KEY 留空时文本请求复用图像上游（单 KEY 全能）
ENV API_PROXY_URL=
ENV API_PROXY_KEY=
ENV TEXT_API_URL=
ENV TEXT_API_KEY=
# 默认生图模型与模型注释（前端展示用，不含任何凭据）
ENV DEFAULT_IMAGE_MODEL=
ENV IMAGE_MODEL_NOTES=
# 前端预置的文本配置模型名（如 deepseek-flash）；留空则不预置文本配置
ENV DEFAULT_TEXT_MODEL=
ENV DEFAULT_TEXT_MODEL_NAME=
# 图片代理域名白名单，逗号分隔，如 cdn.example.com,files.example.com
ENV IMAGE_PROXY_ALLOW_HOSTS=
ENV ENABLE_API_PROXY=false
ENV LOCK_API_PROXY=false
ENV SHOW_PRESET_CONFIG_ONLY=false
ENV SHOW_CONFIG_CHANGE_DIALOG=true
ENV LOCK_PRESET_CONFIG_PARAMS=false
ENV PREVENT_PRESET_CONFIG_DELETION=false
ENV DEFAULT_UI_FONT=
ENV DEFAULT_MONO_FONT=
ENV BUILTIN_FONT_SOURCE=

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
# API 代理限流 zone（http 上下文，需在 main.conf 的 conf.d 包含范围内）
COPY deploy/00-api-proxy-zone.conf /etc/nginx/conf.d/00-api-proxy-zone.conf
COPY --chmod=755 deploy/migrate-api-env.envsh /docker-entrypoint.d/05-migrate-api-env.envsh
# 生成 /etc/nginx/relay/ 下的真实上游与图片白名单片段（必须早于 20-envsubst）
COPY --chmod=755 deploy/10-relay-conf.sh /docker-entrypoint.d/10-relay-conf.sh
COPY --chmod=755 deploy/inject-api-url.sh /docker-entrypoint.d/40-inject-api-url.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
